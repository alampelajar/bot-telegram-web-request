# Telegram
BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# Local development uses SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/automatic_web_controller.db
POSTGRES_PASSWORD=change-this-before-deploying

# Augestel API v1. Each Telegram user provides their own API key in a private bot chat.
AUGESTEL_BASE_URL=https://augestel.com
AUGESTEL_API_BASE_URL=https://augestel.com/api/v1/iprn
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK UP THIS KEY SECURELY. Losing/changing it means stored user API keys cannot be decrypted.
API_KEY_ENCRYPTION_KEY=
# Keep false until the operator intentionally enables the documented API integration.
AUGESTEL_INTEGRATION_ENABLED=false

# Application
APP_ENV=development
LOG_LEVEL=INFO
EXPORT_TMP_DIR=./tmp/exports
EXPORT_RETENTION_MINUTES=30

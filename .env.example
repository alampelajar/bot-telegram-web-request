# Telegram
BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# Local development uses SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/automatic_web_controller.db
POSTGRES_PASSWORD=change-this-before-deploying

# Augestel's documented API uses: Authorization: Bearer YOUR_API_KEY
# Set API base URL exactly as shown in Augestel API docs; do not guess it.
AUGESTEL_BASE_URL=https://augestel.com
AUGESTEL_API_BASE_URL=
AUGESTEL_API_KEY=
# Keep false until the official API base URL/endpoints are verified and tested.
AUGESTEL_INTEGRATION_ENABLED=false

# Application
APP_ENV=development
LOG_LEVEL=INFO
EXPORT_TMP_DIR=./tmp/exports
EXPORT_RETENTION_MINUTES=30
